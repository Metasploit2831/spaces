{
  "manifest_version": 3,
  "name": "Spaces",
  "description": "Drag anything. Paste anything. Group anything.",
  "version": "0.1.0",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/style.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Spaces"
  }
}
